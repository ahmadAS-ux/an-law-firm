# PostgreSQL in every environment. Supply real credentials privately; never commit .env.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/anlaw
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
# Presentation only; never authorization.
NEXT_PUBLIC_APP_ENV=staging
# Seed-data testing only. Leave unset before pilot/production.
DEV_LOGIN_PICKER_ENABLED=
DEV_LOGIN_SECRET=
STAGING_BASIC_AUTH=
# Absolute private persistent storage root on shared staging.
UPLOAD_DIR=
# Explicit disposable demo/policy operations only. Leave unset normally.
ALLOW_DEMO_SEED=
CONFIRM_POLICY_RESET=
POLICY_RESET_ACTOR=
