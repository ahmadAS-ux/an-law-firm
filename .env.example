# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Local development (SQLite) — NOT for production
# DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — use your Render / Supabase / Neon URL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# App environment label shown in Settings page
# Set to "staging" on Render staging service, "production" on the live service
NEXT_PUBLIC_APP_ENV=staging
